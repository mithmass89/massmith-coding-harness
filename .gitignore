# Binaries and debug
*.exe
*.eot
*.pdf
*.zip
*.tar.gz
*.dmg
*.pkg

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Runtime data
pids/
*.pid
*.seed
*.pid.lock

# Dependency directories
node_modules/
# Vendored build output (dsh-superagent bundle)
vendor/**/lib/
vendor/**/node_modules/

# Dist
dist/

# TypeScript cache
*.tsbuildinfo

# Optional npm cache
.npm

# Optional yarn cache
.yarn/cache
.yarn/unplugged
.yarn/build-state.yml
.yarn/install-state.gz
.pnp.*

# ENV
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# IDE
.idea/
.vscode/settings.json

# Command Code local state (taste, history, projects, auth)
.commandcode/

# opencode local state (should be kept in home dir)
.opencode/

# OS
.DS_Store
Thumbs.db

# Temp
tmp/
*.tmp
*.bak
