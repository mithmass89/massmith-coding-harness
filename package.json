{
	"name": "massmith-coding-harness",
	"version": "0.1.0",
	"private": true,
	"description": "Shared core + adapters for Command Code, OpenCode and DeepSeek Harness — one core, three adapters",
	"license": "MIT",
	"author": "massmitro89 <mithmass2@gmail.com>",
	"repository": {
		"type": "git",
		"url": "https://github.com/mithmass89/massmith-coding-harness.git"
	},
	"homepage": "https://github.com/mithmass89/massmith-coding-harness#readme",
	"keywords": [
		"ai-agent",
		"coding-agent",
		"commandcode",
		"opencode",
		"deepseek-harness",
		"plugin",
		"guardrails",
		"massmith"
	],
	"packageManager": "pnpm@11.7.0",
	"engines": {
		"node": "^22.19.0 || >=24.0.0"
	},
	"scripts": {
		"test": "node --import tsx packages/core/src/__tests__/core.test.ts",
		"verify:commandcode": "node --import tsx packages/commandcode/index.ts",
		"verify:opencode": "node --import tsx packages/opencode/src/index.ts",
		"dsh:web": "dsh --profile web --patch ./cordis.patch.yml",
		"dsh:combined": "dsh --profile massmith-superagent --patch ./cordis.combined.patch.yml",
		"dsh:combined:dump": "dsh --profile massmith-superagent --patch ./cordis.combined.patch.yml --dump-config",
		"superagent:check": "cd vendor/dsh-superagent && pnpm check"
	}
}
